# ─────────────────────────────────────────────────────────────────────────────
# LifeCart environment variables
#
# Copy this file to .env.local and fill in the values. .env.local is gitignored,
# so never paste real keys into .env.example.
#
# Every integration is optional while developing. If its key is blank, LifeCart
# uses MOCK MODE for that part (seeded products, fake WhatsApp, local DB).
# Open http://localhost:3000/setup to see which integrations are live.
# ─────────────────────────────────────────────────────────────────────────────

# App URL used in WhatsApp "Review & Pay" links.
# Local: http://localhost:3000. To open links from your phone, run
# `npm run tunnel` and paste the https://….trycloudflare.com URL it prints.
APP_URL=http://localhost:3000

# Random secret used to sign one-time approval links. Any long random string.
# Generate one with: openssl rand -hex 32
APPROVAL_SECRET=

# ── 1. AI: Groq (free) ───────────────────────────────────────────────────────
# Where: https://console.groq.com → sign in → API Keys → "Create API Key"
# Paste the key that starts with "gsk_".
AI_PROVIDER=groq
GROQ_API_KEY=

# ── 2. PayPal sandbox ────────────────────────────────────────────────────────
# Where: https://developer.paypal.com → Log in → Apps & Credentials →
#        make sure the toggle says "Sandbox" → Create App (type: Merchant).
# Copy "Client ID" into BOTH PAYPAL_CLIENT_ID and NEXT_PUBLIC_PAYPAL_CLIENT_ID.
# Click "Show" under Secret key 1 and paste it into PAYPAL_CLIENT_SECRET.
# Test buyer login for checkout: Testing Tools → Sandbox Accounts → the
# "Personal" account (email + password are shown under "View/Edit account").
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional, later: Apps & Credentials → your app → Webhooks → Add Webhook →
# URL = <APP_URL>/api/webhooks/paypal. Paste the Webhook ID shown.
PAYPAL_WEBHOOK_ID=

# ── 3. WhatsApp (Meta Cloud API) — NOT USED for now, Meta blocked sign-up ──
# We use the Twilio WhatsApp sandbox instead (section 7). Leave these blank,
# EXCEPT DEMO_WHATSAPP_TO, which Twilio uses too.
# Where: https://developers.facebook.com → My Apps → Create App →
#        use case "Other" → type "Business" → add the "WhatsApp" product →
#        WhatsApp → API Setup.
# WHATSAPP_TOKEN:           the "Temporary access token" (expires in 24h; a
#                           permanent System User token can come later)
# WHATSAPP_PHONE_NUMBER_ID: "Phone number ID" under the test "From" number
#                           (a number ID, NOT the phone number itself)
# WHATSAPP_APP_SECRET:      App settings → Basic → App secret → Show
# WHATSAPP_VERIFY_TOKEN:    any word you make up; type the same word in
#                           WhatsApp → Configuration → Webhook → Verify token
# DEMO_WHATSAPP_TO:         your own phone in international format, digits
#                           only, e.g. 14155550142. Add it under "To" →
#                           "Manage phone number list" on the API Setup page.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
DEMO_WHATSAPP_TO=

# ── 4. Channel3 (product search across stores) ───────────────────────────────
# Where: https://trychannel3.com (or the sponsor link on the hackathon Devpost
#        page) → sign up → dashboard → API keys.
CHANNEL3_API_KEY=

# ── 5. Kernel (cloud browser for coupon checks) ──────────────────────────────
# Where: https://kernel.sh (or the sponsor link on Devpost) → sign up →
#        dashboard → API Keys. Docs: https://kernel.sh/docs
KERNEL_API_KEY=

# ── 6. Database ──────────────────────────────────────────────────────────────
# Leave blank locally: LifeCart runs an embedded Postgres (PGlite) in ./.data.
# For deploy: https://render.com → New → Postgres (free) → copy the
# "External Database URL" (starts with postgresql://).
DATABASE_URL=

# ── 7. WhatsApp via Twilio sandbox (what we use) ─────────────────────────────
# Sign up: https://www.twilio.com/try-twilio (free trial; verify email + phone)
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN: Twilio Console home page → "Account Info"
#   box (click "Show" for the auth token).
# TWILIO_FROM: Console → Messaging → Try it out → Send a WhatsApp message →
#   the sandbox number shown there, written like  whatsapp:+14155238886
# Join the sandbox: on your phone, send the "join <two-words>" code shown on that
#   page to the sandbox number in WhatsApp. If messages stop arriving later,
#   send the join code again (sandbox sessions expire after about 3 days).
# DEMO_WHATSAPP_TO (section 3) = your phone, digits only with country code.
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── 8. Sandbox buyer login (ONLY for automated end-to-end tests; never commit) ──
# Where: developer.paypal.com → Testing Tools → Sandbox Accounts → the US Personal account → View/Edit account.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
